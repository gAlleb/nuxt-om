shamefully-hoist=true
strict-peer-dependencies=false

# npm 10 падает (arborist: "Cannot read properties of null (reading 'edgesOut')")
# на необязательных peer-зависимостях @nuxt/content v3 — они объявлены как "*"
# (@electric-sql/pglite, @libsql/client, sqlite3). Ставим флаг здесь, чтобы
# npm install и npm ci работали одинаково локально и на сервере.
legacy-peer-deps=true
